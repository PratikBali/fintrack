rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user opts their own data into family sharing by writing this mirror;
    // nobody can write into another user's path. Rules-internal get() bypasses
    // rules, so the mirror needs no extra read grant.
    function famAccess(userId) {
      return get(/databases/$(database)/documents/users/$(userId)/settings/familyAccess).data;
    }
    function isFamilyPeer(userId) {
      return request.auth != null
        && request.auth.uid != userId
        && exists(/databases/$(database)/documents/users/$(userId)/settings/familyAccess)
        && request.auth.uid in famAccess(userId).memberUids;
    }
    // The cutoff comes from the family doc, not the mirror, so an owner's policy
    // change applies at once even to members who are currently offline.
    function famSharedFrom(userId) {
      return get(/databases/$(database)/documents/families/$(famAccess(userId).familyId)).data.share.sharedFrom;
    }

    // Private per-user data: transactions, contacts, ledger. Owner-only.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Family members may read each other's expenses, but only from the cutoff
    // date the owner set. A query must carry `where("date", ">=", sharedFrom)`
    // for Firestore to accept the list, which is what enforces the window.
    match /users/{userId}/transactions/{txnId} {
      allow read: if isFamilyPeer(userId)
        && (famSharedFrom(userId) == "0000-01-01"
            || resource.data.date >= famSharedFrom(userId));
    }

    // Budgets are set by the family owner and read-only for everyone else.
    match /users/{userId}/budgets/{budgetId} {
      allow read: if isFamilyPeer(userId);
    }

    // Searchable member directory. Any signed-in user can look others up
    // (needed to add friends by phone/email); you can only edit your own.
    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Invite codes resolve a link to a group. Readable so an invitee can see
    // the group name before joining; immutable once created.
    match /invites/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Shared groups. Any member can read and edit (add members, expenses).
    match /groups/{groupId} {
      function isMember() {
        return request.auth != null
          && request.auth.uid in resource.data.memberUids;
      }
      // Allow a signed-in user to add ONLY themselves (invite-link join).
      function isJoiningSelf() {
        return request.auth != null
          && !(request.auth.uid in resource.data.memberUids)
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && (request.auth.uid in request.resource.data.memberUids);
      }

      allow read: if isMember();
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerUid
        && request.auth.uid in request.resource.data.memberUids;
      allow update: if isMember() || isJoiningSelf();
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerUid;

      match /expenses/{expenseId} {
        allow read, write: if request.auth != null
          && request.auth.uid in
            get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
      }
    }

    // One household. Members read; only the owner edits membership and the
    // share policy, so a member can never widen what others expose.
    match /families/{familyId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberUids;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerUid
        && request.auth.uid in request.resource.data.memberUids;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.ownerUid;
    }

    // Family invite links. Readable by any signed-in user so an invitee can see
    // who invited them; single-use via the status field.
    match /familyInvites/{code} {
      // The invitee may only move a pending invite to accepted or declined, and
      // may only stamp their own identity on it.
      function isRespondingSelf() {
        return request.auth != null
          && resource.data.status == "pending"
          && request.resource.data.status in ["accepted", "declined"]
          && request.resource.data.inviteeUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid;
      }

      // An invitee resolves their own code by id. Only the owner may list, so
      // nobody can sweep the collection for other people's names and emails.
      allow get: if request.auth != null;
      allow list: if request.auth != null
        && request.auth.uid == resource.data.ownerUid;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerUid
        && request.resource.data.status == "pending";
      allow update: if (request.auth != null
          && request.auth.uid == resource.data.ownerUid)
        || isRespondingSelf();
      allow delete: if false;
    }
  }
}
